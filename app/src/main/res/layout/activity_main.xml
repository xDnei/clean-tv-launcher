<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#08080A">

    <ImageView
        android:id="@+id/wallpaperBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.35"
        android:visibility="gone"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Barra Superior e Hero Banner -->
            <FrameLayout
                android:id="@+id/heroContainer"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/heroViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="42dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnProfileAvatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/circle_avatar_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_default_avatar"/>

                    <Button
                        android:id="@+id/btnActivateHome"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="16dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Definir como Tela Inicial"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:focusable="true"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Aplicativos Instalados (Em destaque para acesso imediato) -->
            <LinearLayout
                android:id="@+id/sectionApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="42dp"
                android:paddingEnd="42dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/titleApps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aplicativos"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvApps"
                    android:layout_width="match_parent"
                    android:layout_height="135dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"/>
            </LinearLayout>

            <!-- Continuar Assistindo -->
            <LinearLayout
                android:id="@+id/sectionContinueWatching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="42dp"
                android:paddingEnd="42dp"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/titleContinueWatching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continuar Assistindo"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvContinueWatching"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"/>
            </LinearLayout>

            <!-- Recomendações TMDb -->
            <LinearLayout
                android:id="@+id/sectionRecommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="42dp"
                android:paddingEnd="42dp"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/titleRecommendations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recomendações"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecommendations"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"/>
            </LinearLayout>

            <!-- Em Alta -->
            <LinearLayout
                android:id="@+id/sectionTrending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="42dp"
                android:paddingEnd="42dp"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/titleTrending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Em Alta"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTrending"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
